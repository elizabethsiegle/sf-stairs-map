    <Folder>
      <name>San Francisco Stairway List</name>
      <Placemark>
        <name>Lone Mtn., from No. 401 Parker to Beaumont to Stanyan to Rossi. Long narrow streets, church spires, views of Angel Island and west; nice series of Victorians on McAllister off Parker.</name>
        <description>https://photos.app.goo.gl/vvebp9tB2HmemNw88</description>
        <styleUrl>#icon-1899-F57C00</styleUrl>
        <Point>
          <coordinates>
            -122.4540275,37.7790336,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name><![CDATA[Bessie/Bessie & Mirabel at Shotwell.]]></name>
        <description>https://photos.app.goo.gl/r66QcRjrzqaAMNzv5</description>
        <styleUrl>#icon-1899-FFD600</styleUrl>
        <Point>
          <coordinates>
            -122.4149996,37.7467443,0
          </coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name><![CDATA[Blake/Geary & Euclid, into Laurel Hill Playground.]]></name>
        <description>https://photos.app.goo.gl/jWMurW4XUpUW7htW9</description>
        <styleUrl>#icon-1899-FFD600</styleUrl>
        <Point>
          <coordinates>
            -122.4514495,37.7836955,0
          </coordinates>
        </Point>
      </Placemark>
