{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sf-stairs-map",
  "compatibility_date": "2026-09-14",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "VERIFICATION_REPORTS",
      "id": "07e9e070d726447fbd644b09533b7ca0"
    }
  ]
}
